# 查询与同步并发配置（后端启动后由查询接口直接读取）
# max_workers: 单次租户查询中“订阅级线程池”的最大工作线程数。
# - 作用范围: 仅影响同一次查询请求内、同一租户下的订阅并发。
# - 实际生效: 还会受查询时间范围和订阅数量限制（最终值 <= 订阅数）。
# - 调大影响: 吞吐提升，但会提高 Cost API 并发压力和 429 风险。
max_workers=5

# max_subscriptions_per_query: 单次单租户费用查询允许的最大订阅数。
# - 0 表示不限制数量；大于 0 时超出该数量的请求将被拒绝。
max_subscriptions_per_query=0

# http_pool_connections: requests 连接池分组数（不同主机/连接池槽位数量）。
# - 作用: 影响并发请求时可复用连接的分布能力。
# - 调大影响: 减少高并发下连接竞争，但会增加资源占用。
http_pool_connections=64

# http_pool_maxsize: 每个连接池允许的最大连接数。
# - 建议: 通常应 >= 预期并发请求数，避免线程因等待连接而阻塞。
# - 调大影响: 可降低连接等待，但过大可能增加系统资源占用。
http_pool_maxsize=96

# subscription_list_timeout_seconds: 拉取订阅列表接口超时（秒）。
# - 触发后果: 超时会导致当前租户订阅发现失败。
subscription_list_timeout_seconds=60

# cost_query_timeout_seconds: 单次 Cost API 查询超时（秒）。
# - 作用范围: 汇总查询、明细查询、分页查询均使用该超时。
# - 调大影响: 降低误超时概率，但失败请求会占用连接更久。
cost_query_timeout_seconds=120

# cost_query_max_retries: 发生 429 时的最大重试次数。
# - 总尝试次数 = 1 + cost_query_max_retries。
# - 调大影响: 提高成功率，但会拉长失败场景的整体耗时。
cost_query_max_retries=3

# cost_query_retry_base_seconds: 退避基数秒数（指数退避起点）。
# - 系统会叠加抖动并进行指数递增。
# - 调大影响: 进一步缓解 429 冲突，但重试恢复速度更慢。
cost_query_retry_base_seconds=10

# cost_query_retry_max_delay_seconds: 单次重试等待的最大上限（秒）。
# - 作用: 防止指数退避等待时间过长。
cost_query_retry_max_delay_seconds=120

# global_cost_api_max_inflight: 进程级全局在途 Cost API 请求上限。
# - 作用: 对所有客户端、所有租户共享限流，防止总体并发失控。
# - 调大影响: 吞吐提高，但更容易触发平台限流。
global_cost_api_max_inflight=10

# tenant_cost_api_max_inflight: 单租户在途 Cost API 请求上限。
# - 作用: 保证租户间公平，避免单租户占满全局并发配额。
# - 建议: 小于或等于 global_cost_api_max_inflight。
tenant_cost_api_max_inflight=5

# scope_cost_api_max_inflight: 同一订阅 Scope 的 Cost API 在途上限。
# - Scope 内汇总、明细和分页请求串行，避免同一订阅并发撞击限流。
scope_cost_api_max_inflight=2

# cost_query_rate_limit_enabled: 启用 Tenant/Scope 平滑限速和 429 冷却传播。
cost_query_rate_limit_enabled=true

# tenant_cost_api_requests_per_minute: 单 Tenant Cost API 平均发送速率。
tenant_cost_api_requests_per_minute=15

# scope_cost_api_requests_per_minute: 单订阅 Scope Cost API 平均发送速率。
scope_cost_api_requests_per_minute=3

# scope_cost_api_min_interval_seconds: 同一 Scope 相邻请求最小间隔（秒）。
scope_cost_api_min_interval_seconds=20

# cost_query_retry_jitter_max_seconds: 重试附加随机等待上限（秒）。
cost_query_retry_jitter_max_seconds=3

# cost_query_retry_total_wait_seconds: 单个 Cost API 逻辑请求的累计重试等待上限（秒）。
cost_query_retry_total_wait_seconds=600

# cost_query_client_type: Azure Cost Management 请求客户端标识，必须是非敏感稳定名称。
cost_query_client_type=Azureaq-Superpop

# audit_log_retention_days: 结构化 API 审计日志在本地 SQLite 中的保留天数。
audit_log_retention_days=5
